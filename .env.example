# Google AI Studio key (free tier) — https://aistudio.google.com/apikey
# Drives every AI call in this project: script breakdown, art direction, panels.
GEMINI_API_KEY=replace-me

# Parallel Search API — https://platform.parallel.ai
# Grounds each scene's art direction in cited, real-world visual references.
PARALLEL_API_KEY=replace-me

# Models (free-tier friendly defaults)
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional animatic pass. Veo has no free tier — leave off unless billing is on.
ENABLE_VEO=0
VEO_MODEL=veo-3.1-generate-preview
