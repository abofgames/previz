# Google AI Studio key (free tier) — https://aistudio.google.com/apikey
# Drives every AI call in this project: script breakdown, art direction, panels.
GEMINI_API_KEY=replace-me

# Parallel Search API — https://platform.parallel.ai
# Grounds each scene's art direction in cited, real-world visual references.
PARALLEL_API_KEY=replace-me

# Models. Free-tier daily quota is granted PER MODEL, so when one runs out the
# client rolls forward through a chain of other Google models automatically.
# This just sets where the chain starts.
GEMINI_TEXT_MODEL=gemini-3.5-flash

# Image generation is limit:0 on the free tier for EVERY Gemini image model —
# this only does anything once billing is enabled on the project.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Requests/minute budget the app paces itself to. Raise it once billed.
GEMINI_RPM=5

# Optional animatic pass. Veo has no free tier — leave off unless billing is on.
ENABLE_VEO=0
VEO_MODEL=veo-3.1-generate-preview
